---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="docs-brand" href={siteTitleHref} aria-label="Documentation home">
  <img
    class="docs-brand__icon"
    src={`${import.meta.env.BASE_URL}favicon.svg`}
    alt=""
    width="32"
    height="32"
  />
  <span>Habsum<span class="docs-brand__dot" aria-hidden="true">.</span></span>
</a>
