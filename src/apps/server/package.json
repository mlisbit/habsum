{
  "name": "@habsum/server",
  "version": "0.1.29",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "HABSUM_CONFIG_DIR=\"${INIT_CWD:-$PWD}/config\" tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "HABSUM_CONFIG_DIR=\"${INIT_CWD:-$PWD}/config\" node dist/index.js",
    "init-admin": "node --import tsx src/scripts/init-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@habsum/tracking": "*",
    "@habsum/types": "*",
    "@habsum/utils": "*",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "supertest": "^7.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
