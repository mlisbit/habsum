    "./styles": "./src/styles/index.scss"
  },
  "dependencies": {
    "@habsum/types": "*",
    "@habsum/ui": "*",
    "@habsum/utils": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "eslint-plugin-habsum": "*",
    "typescript-eslint": "8.48.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
