{
  "name": "@habsum/habit-render",
  "version": "0.1.32",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.scss"
  ],
  "scripts": {
    "typecheck": "tsc",
    "lint:js": "eslint ."
