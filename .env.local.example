# Copy to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit secrets.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Quote values that contain spaces or angle brackets.
# Domain must be verified at https://resend.com/domains before using your own address.
RESEND_FROM="Habsum <auth@habsum.com>"

# Public webapp URL (password-reset links in emails)
HABSUM_WEBAPP_URL=http://localhost:3000
