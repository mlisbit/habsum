{
  "name": "habsum",
  "version": "0.1.35",
  "private": true,
  "description": "Habit tracker - lightweight Express server + React Router webapp",
  "workspaces": [
    "src/packages/types",
    "src/packages/tracking",
    "src/packages/utils",
    "src/packages/ui",
    "src/packages/habit-render",
    "src/packages/eslint",
    "src/packages/stylelint",
    "src/apps/habsum-admin",
    "src/apps/server",
    "src/apps/webapp"
  ],
  "scripts": {
    "dev:server": "npm --workspace src/apps/server run dev",
    "dev:webapp": "npm --workspace src/apps/webapp run dev",
    "dev:ports:free": "node scripts/kill-dev-ports.mjs 3000 3001",
    "dev": "npm run dev:ports:free && npm-run-all --parallel dev:server dev:webapp",
    "start": "npm --workspace src/apps/server run start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "init-admin": "npm --workspace src/apps/server run init-admin --",
    "lint": "npm run lint:plugins:build && npm run lint:js && npm run lint:css:run",
    "lint:js": "npm run lint:js --workspace @habsum/webapp && npm run lint:js --workspace @habsum/ui && npm run lint:js --workspace @habsum/habit-render",
    "lint:css": "npm run stylelint-plugins:build && npm run lint:css:run",
    "lint:css:run": "stylelint \"src/**/*.{css,scss}\"",
    "lint:css:fix": "npm run stylelint-plugins:build && npm run lint:css:run -- --fix",
    "lint:plugins:build": "npm run stylelint-plugins:build && npm run eslint-plugins:build",
    "test": "npm-run-all test:admin test:webapp test:server",
    "test:admin": "npm run test --workspace @habsum/admin",
    "test:webapp": "npm run test --workspace @habsum/webapp",
    "test:server": "npm run test --workspace @habsum/server",
    "secrets:check": "node scripts/check-staged-secrets.mjs",
    "stylelint-plugins:build": "npm run build --workspace @habsum/stylelint-plugins",
    "stylelint-plugins:watch": "npm run watch --workspace @habsum/stylelint-plugins",
    "eslint-plugins:build": "tsc -p src/packages/eslint/tsconfig.json",
    "eslint-plugins:watch": "tsc -p src/packages/eslint/tsconfig.json --watch",
    "prepare": "husky && npm run stylelint-plugins:build && npm run eslint-plugins:build"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "eslint-plugin-habsum": "*",
    "typescript-eslint": "8.48.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.8.3",
    "stylelint": "17.9.1",
    "stylelint-config-standard-scss": "17.0.0"
  },
  "lint-staged": {
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "src/apps/webapp/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --config src/apps/webapp/eslint.config.mjs"
    ],
    "src/packages/ui/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --config src/packages/ui/eslint.config.mjs"
    ],
    "*.{js,jsx,ts,tsx,json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
