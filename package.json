{
  "name": "habsum",
  "version": "0.1.1",
  "private": true,
  "description": "Habit tracker - lightweight Express server + Remix webapp",
  "workspaces": [
    "src/packages/types",
    "src/packages/utils",
    "src/packages/eslint",
    "src/packages/stylelint",
    "src/apps/server",
    "src/apps/webapp"
  ],
  "scripts": {
    "dev:server": "HABSUM_CONFIG_DIR=\"$PWD/config\" npm --workspace src/apps/server run dev",
    "dev:webapp": "npm --workspace src/apps/webapp run dev",
    "dev": "npm-run-all --parallel dev:server dev:webapp",
    "start": "HABSUM_CONFIG_DIR=\"$PWD/config\" npm --workspace src/apps/server run start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "npm run lint:js --workspace @habsum/webapp",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "prelint:css": "npm run stylelint-plugins:build",
    "prelint:css:fix": "npm run stylelint-plugins:build",
    "stylelint-plugins:build": "npm run build --workspace @habsum/stylelint-plugins",
    "stylelint-plugins:watch": "npm run watch --workspace @habsum/stylelint-plugins",
    "eslint-plugins:build": "tsc -p src/packages/eslint/tsconfig.json",
    "eslint-plugins:watch": "tsc -p src/packages/eslint/tsconfig.json --watch",
    "prepare": "husky && npm run stylelint-plugins:build && npm run eslint-plugins:build"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "eslint-plugin-habsum": "*",
    "typescript-eslint": "8.48.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.8.3",
    "stylelint": "17.9.1",
    "stylelint-config-standard-scss": "17.0.0"
  },
  "lint-staged": {
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "src/apps/webapp/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --config src/apps/webapp/eslint.config.mjs"
    ],
    "*.{js,jsx,ts,tsx,json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
