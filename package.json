{
  "name": "habsum",
  "version": "0.1.0",
  "private": true,
  "description": "Habit tracker - lightweight Express server + Remix webapp",
  "workspaces": [
    "src/packages/*",
    "src/apps/server",
    "src/apps/webapp"
  ],
  "scripts": {
    "dev:server": "HABSUM_CONFIG_DIR=\"$PWD/config\" npm --workspace src/apps/server run dev",
    "dev:webapp": "npm --workspace src/apps/webapp run dev",
    "dev": "npm-run-all --parallel dev:server dev:webapp",
    "start": "HABSUM_CONFIG_DIR=\"$PWD/config\" npm --workspace src/apps/server run start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
