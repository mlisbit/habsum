{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": [
    "./src/packages/tools/dist/stylelint/single-block-per-file.mjs",
    "./src/packages/tools/dist/stylelint/require-spacing-function.mjs",
    "./src/packages/tools/dist/stylelint/no-direct-color.mjs",
    "./src/packages/tools/dist/stylelint/bem-block-matches-filename.mjs"
  ],
  "overrides": [
    {
      "files": [
        "src/apps/webapp/app/styles/_reset.scss",
        "src/apps/webapp/app/styles/_tokens.scss"
      ],
      "rules": {
        "selector-max-type": null,
        "habsum/require-spacing-function": null,
        "habsum/no-direct-color": null
      }
    },
    {
      "files": ["src/apps/webapp/app/styles/_reset.scss"],
      "rules": {
        "property-disallowed-list": [
          ["font-size", "line-height", "font-weight"],
          {
            "message": "Use atomic typography classes (.text-h-*, .text-b-*, .text-light, .text-bold) defined in foundation/_text.scss"
          }
        ]
      }
    },
    {
      "files": ["src/apps/webapp/app/styles/core-components/_button.scss"],
      "rules": {
        "property-disallowed-list": [
          ["font-size", "line-height", "font-weight"],
          {
            "message": "Use atomic typography classes (.text-h-*, .text-b-*, .text-light, .text-bold) defined in foundation/_text.scss"
          }
        ]
      }
    },
    {
      "files": ["src/apps/webapp/app/styles/foundation/_text.scss"],
      "rules": {
        "property-disallowed-list": null
      }
    },
    {
      "files": [
        "src/apps/webapp/app/styles/foundation/_text.scss",
        "src/apps/webapp/app/styles/foundation/_layout.scss"
      ],
      "rules": {
        "habsum/bem-block-matches-filename": null,
        "habsum/single-block-per-file": null
      }
    }
  ],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Expected class selector to be kebab-case BEM (block__element--modifier)"
      }
    ],
    "media-feature-range-notation": "prefix",
    "property-no-vendor-prefix": [true, { "ignoreProperties": ["/text-size-adjust$/"] }],
    "value-keyword-case": ["lower", { "ignoreProperties": ["/font/"] }],
    "scss/at-function-pattern": "^_?[a-z][a-z0-9-]*$",
    "at-rule-empty-line-before": null,
    "property-disallowed-list": [
      ["font-size", "line-height", "font-weight", "color"],
      {
        "message": "Use atomic text utility classes (.text-h-*, .text-b-*, .text-light, .text-bold) defined in foundation/_text.scss"
      }
    ],
    "habsum/single-block-per-file": true,
    "habsum/require-spacing-function": true,
    "habsum/no-direct-color": true,
    "habsum/bem-block-matches-filename": true,
    "selector-max-type": 0
  }
}
