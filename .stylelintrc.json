{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": [
    "./src/packages/stylelint/dist/rules/single-block-per-file/index.mjs",
    "./src/packages/stylelint/dist/rules/require-spacing-function/index.mjs",
    "./src/packages/stylelint/dist/rules/token-use-enforcer/index.mjs",
    "./src/packages/stylelint/dist/rules/bem-block-matches-filename/index.mjs",
    "./src/packages/stylelint/dist/rules/theme-token-parity/index.mjs",
    "./src/packages/stylelint/dist/rules/theme-token-order/index.mjs",
    "./src/packages/stylelint/dist/rules/atomic-class-enforcer/index.mjs"
  ],
  "overrides": [
    {
      "files": [
        "src/packages/ui/src/styles/_reset.scss",
        "src/packages/ui/src/styles/_tokens.scss"
      ],
      "rules": {
        "selector-max-type": null,
        "habsum/require-spacing-function": null,
        "habsum/token-use-enforcer": null,
        "habsum/single-block-per-file": null
      }
    },
    {
      "files": [
        "src/packages/ui/src/styles/foundation/_text.scss",
        "src/packages/ui/src/styles/foundation/_atomic.scss"
      ],
      "rules": {
        "habsum/bem-block-matches-filename": null,
        "habsum/single-block-per-file": null
      }
    },
    {
      "files": ["src/packages/ui/src/styles/_theme.scss"],
      "rules": {
        "selector-max-type": null,
        "habsum/bem-block-matches-filename": null,
        "habsum/single-block-per-file": null
      }
    }
  ],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Expected class selector to be kebab-case BEM (block__element--modifier)"
      }
    ],
    "media-feature-range-notation": "prefix",
    "property-no-vendor-prefix": [true, { "ignoreProperties": ["/text-size-adjust$/"] }],
    "value-keyword-case": ["lower", { "ignoreProperties": ["/font/"] }],
    "scss/at-function-pattern": "^_?[a-z][a-z0-9-]*$",
    "at-rule-empty-line-before": null,
    "habsum/atomic-class-enforcer": true,
    "habsum/single-block-per-file": true,
    "habsum/require-spacing-function": true,
    "habsum/token-use-enforcer": [
      true,
      { "tokensFile": "src/packages/ui/src/styles/_tokens.scss" }
    ],
    "habsum/bem-block-matches-filename": true,
    "habsum/theme-token-parity": [
      true,
      { "tokensFile": "src/packages/ui/src/styles/_tokens.scss" }
    ],
    "habsum/theme-token-order": [true, { "tokensFile": "src/packages/ui/src/styles/_tokens.scss" }],
    "selector-max-type": 0
  }
}
